<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Kida.Service.Client</AssemblyName>
    <RootNamespace>Kida.Service.Client</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Kida.Service.Client</PackageId>
    <Version>$(KidaPackageVersion)</Version>
    <Description>Haley-based client for trusted product hosts communicating with Kida Service.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Choose>
    <When Condition="'$(KidaUsePackageReferences)' != 'true' and Exists('$(KidaIdentityContractsProj)') and Exists('$(KidaAccessContractsProj)') and Exists('$(KidaAccessDomainProj)') and Exists('$(KidaTenancyContractsProj)') and Exists('$(KidaEntitlementsContractsProj)') and Exists('$(KidaAppsContractsProj)')">
      <ItemGroup>
        <ProjectReference Include="$(KidaIdentityContractsProj)" />
        <ProjectReference Include="$(KidaAccessContractsProj)" />
        <ProjectReference Include="$(KidaAccessDomainProj)" />
        <ProjectReference Include="$(KidaTenancyContractsProj)" />
        <ProjectReference Include="$(KidaEntitlementsContractsProj)" />
        <ProjectReference Include="$(KidaAppsContractsProj)" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup><PackageReference Include="Kida.Contracts" /></ItemGroup>
    </Otherwise>
  </Choose>
  <Choose>
    <When Condition="'$(KidaUseHaleyPackageReferences)' == 'false'">
      <ItemGroup>
        <ProjectReference Include="$(HaleyAbstractions)\HaleyAbstractions.csproj"><Name>HaleyAbstractions</Name></ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup><PackageReference Include="Haley.Abstractions" /></ItemGroup>
    </Otherwise>
  </Choose>
  <Choose>
    <When Condition="'$(KidaUseHaleyPackageReferences)' == 'false'">
      <ItemGroup>
        <ProjectReference Include="$(HaleyExtensions)\HaleyExtensions.csproj"><Name>HaleyExtensions</Name></ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup><PackageReference Include="Haley.Extensions" /></ItemGroup>
    </Otherwise>
  </Choose>
  <Choose>
    <When Condition="'$(KidaUseHaleyPackageReferences)' == 'false'">
      <ItemGroup>
        <ProjectReference Include="$(HaleyRest)\HaleyRest.csproj"><Name>HaleyRest</Name></ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup><PackageReference Include="Haley.Rest" /></ItemGroup>
    </Otherwise>
  </Choose>
  <Choose>
    <When Condition="'$(KidaUseHaleyPackageReferences)' == 'false'">
      <ItemGroup>
        <ProjectReference Include="$(HaleyHelpers)\HaleyHelpers.csproj"><Name>HaleyHelpers</Name></ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup><PackageReference Include="Haley.Helpers" /></ItemGroup>
    </Otherwise>
  </Choose>
  <Choose>
    <When Condition="'$(KidaUseHaleyPackageReferences)' == 'false'">
      <ItemGroup><ProjectReference Include="$(HaleyHelpersIdentityProj)" /></ItemGroup>
    </When>
    <Otherwise><ItemGroup><PackageReference Include="Haley.Helpers.Identity" /></ItemGroup></Otherwise>
  </Choose>
</Project>
