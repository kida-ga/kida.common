<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <KidaPackageVersion Condition="'$(KidaPackageVersion)' == ''">0.1.0</KidaPackageVersion>
    <Authors>Kida GA</Authors>
    <Company>Kida GA</Company>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kida-ga/common</RepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <KidaIdentityContractsProj Condition="'$(KidaIdentityContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Identity.Contracts\Kida.Identity.Contracts.csproj</KidaIdentityContractsProj>
    <KidaAccessContractsProj Condition="'$(KidaAccessContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Access.Contracts\Kida.Access.Contracts.csproj</KidaAccessContractsProj>
    <KidaAccessDomainProj Condition="'$(KidaAccessDomainProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Access.Domain\Kida.Access.Domain.csproj</KidaAccessDomainProj>
    <KidaTenancyContractsProj Condition="'$(KidaTenancyContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Tenancy.Contracts\Kida.Tenancy.Contracts.csproj</KidaTenancyContractsProj>
    <KidaEntitlementsContractsProj Condition="'$(KidaEntitlementsContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Entitlements.Contracts\Kida.Entitlements.Contracts.csproj</KidaEntitlementsContractsProj>
    <KidaAppsContractsProj Condition="'$(KidaAppsContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Apps.Contracts\Kida.Apps.Contracts.csproj</KidaAppsContractsProj>
    <KidaServiceClientProj Condition="'$(KidaServiceClientProj)' == ''">$(MSBuildThisFileDirectory)Clients\Kida.Service.Client\Kida.Service.Client.csproj</KidaServiceClientProj>
  </PropertyGroup>
  <PropertyGroup Condition="'$(KidaUseHaleyPackageReferences)' != 'true'">
    <HaleyProject Condition="'$(HaleyProject)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\HaleyProject')">$(MSBuildThisFileDirectory)..\..\HaleyProject</HaleyProject>
    <HaleyAbstractions Condition="'$(HaleyAbstractions)' == '' and '$(HaleyProject)' != ''">$(HaleyProject)\HaleyAbstractions\HaleyAbstractions</HaleyAbstractions>
    <HaleyExtensions Condition="'$(HaleyExtensions)' == '' and '$(HaleyProject)' != ''">$(HaleyProject)\HaleyExtensions\HaleyExtensions</HaleyExtensions>
    <HaleyHelpers Condition="'$(HaleyHelpers)' == '' and '$(HaleyProject)' != ''">$(HaleyProject)\HaleyHelpers\HaleyHelpers</HaleyHelpers>
    <HaleyHelpersWeb Condition="'$(HaleyHelpersWeb)' == '' and '$(HaleyProject)' != ''">$(HaleyProject)\HaleyHelpers.Web\HaleyHelpersWeb</HaleyHelpersWeb>
    <HaleyRest Condition="'$(HaleyRest)' == '' and '$(HaleyProject)' != ''">$(HaleyProject)\HaleyRest\HaleyRest</HaleyRest>
  </PropertyGroup>
</Project>
