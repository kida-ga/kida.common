<Project>
  <PropertyGroup>
    <KidaUseHaleyPackageReferences Condition="'$(KidaUseHaleyPackageReferences)' == '' and $([System.String]::Copy('$(SolutionName)').EndsWith('_Ref'))">false</KidaUseHaleyPackageReferences>
    <KidaUseHaleyPackageReferences Condition="'$(KidaUseHaleyPackageReferences)' == ''">true</KidaUseHaleyPackageReferences>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <KidaPackageVersion Condition="'$(KidaPackageVersion)' == ''">0.1.0</KidaPackageVersion>
    <Authors>Kida GA</Authors>
    <Company>Kida GA</Company>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kida-ga/common</RepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <KidaIdentityContractsProj Condition="'$(KidaIdentityContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Identity.Contracts\Kida.Identity.Contracts.csproj</KidaIdentityContractsProj>
    <KidaAccessContractsProj Condition="'$(KidaAccessContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Access.Contracts\Kida.Access.Contracts.csproj</KidaAccessContractsProj>
    <KidaAccessDomainProj Condition="'$(KidaAccessDomainProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Access.Domain\Kida.Access.Domain.csproj</KidaAccessDomainProj>
    <KidaTenancyContractsProj Condition="'$(KidaTenancyContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Tenancy.Contracts\Kida.Tenancy.Contracts.csproj</KidaTenancyContractsProj>
    <KidaEntitlementsContractsProj Condition="'$(KidaEntitlementsContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Entitlements.Contracts\Kida.Entitlements.Contracts.csproj</KidaEntitlementsContractsProj>
    <KidaAppsContractsProj Condition="'$(KidaAppsContractsProj)' == ''">$(MSBuildThisFileDirectory)Contracts\Kida.Apps.Contracts\Kida.Apps.Contracts.csproj</KidaAppsContractsProj>
    <KidaServiceClientProj Condition="'$(KidaServiceClientProj)' == ''">$(MSBuildThisFileDirectory)Clients\Kida.Service.Client\Kida.Service.Client.csproj</KidaServiceClientProj>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)ProjectReferences_Kida.Common_Ref.txt"
          Condition="'$(KidaUseHaleyPackageReferences)' == 'false'" />
  <Target Name="ValidateKidaHaleyReferences" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(KidaUseHaleyPackageReferences)' != 'true' and '$(KidaUseHaleyPackageReferences)' != 'false'"
           Text="KidaUseHaleyPackageReferences must be true (packages) or false (source)." />
    <ItemGroup Condition="'$(KidaUseHaleyPackageReferences)' == 'false'">
      <_KidaHaleySourceReference Include="@(ProjectReference)"
                                 Condition="$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('Haley'))" />
    </ItemGroup>
    <Error Condition="'%(_KidaHaleySourceReference.Identity)' != '' and !Exists('%(_KidaHaleySourceReference.Identity)')"
           Text="Haley source mode requires '%(_KidaHaleySourceReference.FullPath)'. Restore the source checkout or correct HaleyProject. Use package mode explicitly to consume NuGet packages." />
  </Target>
</Project>
