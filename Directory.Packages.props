<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Haley.Abstractions" Version="1.3.14" />
    <PackageVersion Include="Haley.Extensions" Version="2.4.15" />
    <PackageVersion Include="Haley.Helpers" Version="2.4.14" />
    <PackageVersion Include="Haley.Helpers.Web" Version="0.2.11" />
    <PackageVersion Include="Haley.Rest" Version="3.0.29" />
    <PackageVersion Include="Kida.Contracts" Version="$(KidaPackageVersion)" />
    <PackageVersion Include="Kida.Service.Client" Version="$(KidaPackageVersion)" />
    <PackageVersion Include="Kida.Licensing" Version="$(KidaPackageVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.20.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.20.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.20.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.20.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.20.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.20.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.20.0" />
  </ItemGroup>
</Project>
